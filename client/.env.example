# Cloudflare Pages uses this relative URL so the Pages Function can proxy API calls.
VITE_API_URL=/api/v1

# Public Firebase web-app settings (safe to expose; restrict the API key in Google Cloud)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
