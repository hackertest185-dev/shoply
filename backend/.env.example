APP_NAME=Shoply E-Commerce API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
ENABLE_LEGACY_DELIVERY=false
ENABLE_ONLINE_PAYMENTS=false
PORT=8000

# Public frontend origins, encoded as a JSON array.
ALLOWED_ORIGINS=["https://your-project.pages.dev"]

MONGO_URI=mongodb+srv://shoply_user:replace_me@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=shoply
REDIS_URL=redis://default:replace_me@your-render-keyvalue.internal:6379

# Generate a new RS256 pair for every environment. Keep the private key secret.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_MFA_REQUIRED=true
ADMIN_MFA_TTL_SECONDS=300
ADMIN_MFA_MAX_ATTEMPTS=5
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=10
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1
PASSWORD_MIN_LENGTH=12
MAX_REQUEST_BODY_BYTES=12582912
PRODUCT_IMAGE_MAX_BYTES=6291456
DELIVERY_DOCUMENT_MAX_BYTES=10485760
DELIVERY_PROOF_MAX_BYTES=15728640

# Leave empty while WhatsApp checkout is the only payment flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_PRODUCTS=
S3_BUCKET_DELIVERY_DOCS=
S3_BUCKET_PROOF=

SENDGRID_API_KEY=
# For personal Gmail this is always the authenticated SMTP_USER mailbox.
# For other providers use an address verified by that provider.
EMAIL_FROM=
EMAIL_FROM_NAME=Shoply

# Gmail SMTP for email login/registration OTP. Use a Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password

OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_LOCK_SECONDS=600
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TTL_SECONDS=86400
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_MAX_ATTEMPTS=5
FRONTEND_URL=https://your-project.pages.dev
